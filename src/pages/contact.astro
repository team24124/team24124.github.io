---
import Page from "../layouts/Page.astro";

---

<Page title="Contact">
    <div class="segment">
        <h1>Contact Us</h1>
		<p>With questions, concerns or inquiries please reach out to one of our mentors or fill out the form below.</p>
        
        <p>Contact one of our mentors by clicking the links below to start a new message!</p>
        <ul id="contactlist">
            <li><a href="mailto:"><i class="fa fa-envelope"></i> Chad Johnston</a></li>
            <li><a href="mailto:"><i class="fa fa-envelope"></i> Megan Buick</a></li>
        </ul>

        <br>

        <div class="segment colored" id="contactform">
            
                <form  action="https://api.web3forms.com/submit" method="POST">
                    <b>Contact Form</b>
                    <p>Alternatively, feel free to use this contact form to reach out to our team email. Include a detailed message to establish the subject matter! We'll respond as soon as possible.</p>


                    <!-- Web3Forms Access Key -->
                    <input type="hidden" name="access_key" value="f103c5d9-ab95-42a9-989b-66cd9a1e169e">

                    <!-- Form Inputs. Each input must have a name="" attribute -->
                    <input type="text" name="name" placeholder="Full Name" required>
                    <input type="email" name="email" placeholder="Email" required>

                    <textarea name="message" placeholder="Your Message" required></textarea>

                    <!-- Honeypot Spam Protection -->
                    <input type="checkbox" name="botcheck" class="hidden" style="display: none;">

                    <!-- Custom Confirmation / Success Page -->
                    <!-- <input type="hidden" name="redirect" value="https://mywebsite.com/thanks.html"> -->

                    <button type="submit">Submit Form</button>
                </form>
        </div>
	</div>
</Page>