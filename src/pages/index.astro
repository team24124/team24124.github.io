---
import Page from "../layouts/Page.astro";
import teamPhoto from "../assets/media/250201 Robotics Tournament-0823-IMG_1301 (Vaast).jpg";
import awardPhoto from "../assets/media/IMG_8003.jpg"
import polarisLogo from "../assets/media/polaris_smart_transparent.png"
import fidelityLogo from "../assets/media/FidelityGroupDark_logo-black-rgb.png"
---

<Page title="Home">
	<div class="segment">
		<img class="full" id="teamPhoto" src={teamPhoto.src} alt="2024-2025 Full Team Photo">
		<p>
			<b>Nighthawks Robotics</b> is a high school robotics team from <b>North Trail High School</b> in <b>Calgary, Alberta</b> with three teams competing in the <i>FIRST Tech Challenge</i>.
		</p>

		<div class="segment colored">
			<h3>How do we compete?</h3>
			<p>
				We compete as part of the annual <a href="https://www.firstinspires.org/robotics/ftc"><b>FIRST Tech Challenge</b></a>. 
				Every season we design, engineer and program a new robot to complete tasks as part of that season's game. 
			</p>

			<p>View an explainer of last season's game here to get a sense of the objectives!</p>
			<iframe width="800" height="450" src="https://www.youtube.com/embed/ewlDPvRK4U4"> </iframe>
			<p>
				We approach competition with the FIRST philosophy of <a href="https://ftc-docs.firstinspires.org/en/latest/gracious_professionalism/gp.html"><i>Gracious Professionalism</i></a> and encourage discovery, teamwork, inclusion and fun throughout our team, school and region!
			</p>
		</div>

		<div class="segment colored">
			<h3>What have we done?</h3>
			<p>Find below a list of achievements and awards given to our teams during competitions.</p>
			
			<b>24124</b>
			<ul style="margin: 5px 0;">
				<li>
					<b>2024-2025 (Into the Deep)</b>
					<ul>
						<li>Winning Alliance - 1st Team Selected @ Nii’miis’stii League Tournament</li>
						<li>Inspires Award - 2nd Place @ Nii’miis’stii League Tournament</li>
						<li>Playoff Team @ Alberta Championships</li>
					</ul>
				</li>
			</ul>

			<b>26145</b>
			<ul style="margin: 5px 0;">
				<li>
					<b>2024-2025 (Into the Deep)</b>
					<ul>
						<li>Finalist Alliance - 1st Team Selected @ Nii’miis’stii League Tournament</li>
						<li>Inspires Award - 3rd Place @ Nii’miis’stii League Tournament</li>
						<li>Playoff Team @ Alberta Championships</li>
					</ul>
				</li>
			</ul>

			<img class="full" src={awardPhoto.src} alt="26145 2024-2025 League Tournament Awards">
		</div>

		<div class="segment colored">
			<h3>Thank you to our sponsors!</h3>
			<p>Big thank you to all the sponsors that have helped make our team possible!</p>
			<section id="sponsorLogos">
				<a href="https://www.polarisblinds.ca/"><img src={polarisLogo.src}></a>
				<div class="sponsorText">
					<h1>Polaris Blinds</h1>
					<h3>Nighthawks</h3>
				</div>
				<a href="https://www.fidelitymanufacturinggroup.com/"><img src={fidelityLogo.src}></a>
				<div class="sponsorText">
					<h1>Fidelity Manufacturing Group</h1>
					<h3>Fledgling</h3>
				</div>
				
			</section>
		</div>
	</div>
	
	
</Page>
